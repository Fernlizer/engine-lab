{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fernlizer/engine-lab/specs/schemas/engineering-parameter.schema.json",
  "title": "Engineering Parameter",
  "description": "An evidence-carrying scalar engineering parameter. Null represents an explicitly unknown value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "unit",
    "source_id",
    "evidence_level",
    "value_class",
    "method",
    "status",
    "notes"
  ],
  "properties": {
    "value": {
      "type": ["number", "string", "boolean", "null"]
    },
    "unit": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "source_id": {
      "type": ["string", "null"],
      "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"
    },
    "evidence_level": {
      "enum": ["A", "B", "C", "D", "E", "F", "UNKNOWN"]
    },
    "value_class": {
      "enum": ["factory", "direct_measurement", "secondary_source", "derived", "assumption", null]
    },
    "method": {
      "enum": ["factory_spec", "direct_measurement", "secondary_source", "observation_synthesis", "derived", "assumption", null]
    },
    "status": {
      "enum": ["candidate", "verified", "disputed", "unknown"]
    },
    "notes": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_id", "input_record_ids"],
      "properties": {
        "equation_id": { "type": "string", "minLength": 1 },
        "input_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure"],
      "properties": {
        "procedure": { "type": "string", "minLength": 1 },
        "instrument": { "type": ["string", "null"] },
        "uncertainty": { "type": ["number", "null"], "minimum": 0 },
        "uncertainty_unit": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["derivation"] },
            { "required": ["measurement"] }
          ]
        },
        "properties": {
          "value": { "const": null },
          "source_id": { "const": null },
          "evidence_level": { "const": "UNKNOWN" },
          "value_class": { "const": null },
          "method": { "const": null }
        }
      },
      "else": {
        "properties": {
          "value": { "not": { "type": "null" } },
          "evidence_level": { "not": { "const": "UNKNOWN" } },
          "value_class": { "not": { "type": "null" } },
          "method": { "not": { "type": "null" } }
        }
      }
    },
    {
      "if": { "properties": { "value_class": { "const": "factory" } }, "required": ["value_class"] },
      "then": {
        "properties": {
          "source_id": { "type": "string" },
          "evidence_level": { "const": "A" },
          "method": { "const": "factory_spec" }
        }
      }
    },
    {
      "if": { "properties": { "value_class": { "const": "direct_measurement" } }, "required": ["value_class"] },
      "then": {
        "properties": {
          "source_id": { "type": "string" },
          "evidence_level": { "const": "B" },
          "method": { "const": "direct_measurement" }
        }
      }
    },
    {
      "if": { "properties": { "value_class": { "const": "secondary_source" } }, "required": ["value_class"] },
      "then": {
        "properties": {
          "source_id": { "type": "string" },
          "evidence_level": { "enum": ["C", "D", "E"] },
          "method": { "enum": ["secondary_source", "observation_synthesis"] }
        }
      }
    },
    {
      "if": { "properties": { "value_class": { "enum": ["derived", "assumption"] } }, "required": ["value_class"] },
      "then": { "properties": { "evidence_level": { "const": "F" } } }
    },
    {
      "if": { "properties": { "value_class": { "const": "derived" } }, "required": ["value_class"] },
      "then": {
        "required": ["derivation"],
        "properties": { "method": { "const": "derived" } }
      }
    },
    {
      "if": { "properties": { "value_class": { "const": "direct_measurement" } }, "required": ["value_class"] },
      "then": { "required": ["measurement"] }
    },
    {
      "if": { "properties": { "value_class": { "const": "assumption" } }, "required": ["value_class"] },
      "then": {
        "properties": {
          "method": { "const": "assumption" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
