{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fernlizer/engine-lab/specs/schemas/part-record.schema.json",
  "title": "Engine Lab Part Record",
  "description": "An applicability-aware catalog identity for one part. Physical attributes remain separate evidence-carrying engineering parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "manufacturer",
    "catalog_source_id",
    "catalog_locator",
    "part_number",
    "description",
    "quantity",
    "applicability",
    "supersedes",
    "superseded_by",
    "attributes",
    "status",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^PART-[A-Z0-9][A-Z0-9-]*$" },
    "manufacturer": { "type": "string", "minLength": 1 },
    "catalog_source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$" },
    "catalog_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "reference_number", "page"],
      "properties": {
        "block": { "type": "string", "minLength": 1 },
        "reference_number": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "part_number": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "quantity": { "type": ["integer", "null"], "minimum": 0 },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "market", "year", "serial_range", "area_code", "notes"],
        "properties": {
          "model": { "type": ["string", "null"] },
          "market": { "type": ["string", "null"] },
          "year": { "type": ["integer", "string", "null"] },
          "serial_range": { "type": ["string", "null"] },
          "area_code": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "superseded_by": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "attributes": {
      "type": "array",
      "description": "Physical dimensions, material, mass, tolerance, clearance, torque, or limits. Each item carries its own provenance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter_id", "parameter", "locator"],
        "properties": {
          "parameter_id": { "type": "string", "minLength": 1 },
          "parameter": { "$ref": "engineering-parameter.schema.json" },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "section"],
            "properties": {
              "page": { "type": ["integer", "null"], "minimum": 1 },
              "section": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "status": { "enum": ["candidate", "verified", "disputed"] },
    "notes": { "type": ["string", "null"] }
  }
}
